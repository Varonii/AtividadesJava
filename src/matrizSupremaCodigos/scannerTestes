import java.util.Scanner;
public class scannerTestes {
    public static void main(String[] args) {
        somar(); //subrotina abre e fecha parênteses
        System.out.println("Fim do programa");
        somar(6,7);
        System.out.println("Fim do programa");
        Scanner sc = new Scanner(System.in);
        System.out.print("Informe o valor 1: ");
        int a = sc.nextInt();
        System.out.print("Informe o valor 2: ");
        int b = sc.nextInt();
        int resultado = multiplicar(a, b);
        System.out.println("A multiplicação de " + a + " x " + b + " = " + (resultado));
        double resultado2 = dividir(a, b);
        System.out.println("A divisão de " + a + " / " + b + " = " + (resultado2));
    }

    public static double dividir(int a, int b){
        return a / b;
    }
    public static int multiplicar(int a, int b){
        return a * b;

    }
    public static void somar(){
        System.out.println("A soma de 2 + 2 é = 4");
    }
    public static void somar(int a, int b){
        System.out.println("A soma de "+ a + " + "+ b + " é = " + (a + b));
    }
}
